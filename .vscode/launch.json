{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run VM Manager (core + providers)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/hyperv",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/qemu"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/extensions/*/dist/**/*.js"],
      "preLaunchTask": "build"
    },
    {
      "name": "Run VM Manager (core only, fake provider)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
