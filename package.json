{
  "name": "vm-manager",
  "displayName": "VM Manager",
  "description": "Manage virtual machines (Hyper-V, QEMU, Proxmox, ...) from VS Code: clusters, nodes, power actions, graphical and serial consoles.",
  "version": "0.8.0",
  "publisher": "sourceregistry",
  "icon": "media/icon.png",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SourceRegistry/vscode-virtual-machine-manager.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "virtual machine",
    "vm",
    "hypervisor",
    "hyper-v",
    "qemu",
    "proxmox",
    "novnc"
  ],
  "main": "./dist/extension.js",
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build",
    "watch:extension": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch --mode development",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p extensions/hyperv/tsconfig.json --noEmit && tsc -p extensions/qemu/tsconfig.json --noEmit && tsc -p extensions/proxmox/tsconfig.json --noEmit && tsc -p extensions/libvirt/tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.webview.json --threshold error",
    "test": "vitest run",
    "test:integration": "node test/integration/runTest.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "vscode:prepublish": "npm run build"
  },
  "activationEvents": [
    "onWebviewPanel:vmm.overview"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vmm",
          "title": "Virtual Machines",
          "icon": "$(vm)"
        }
      ]
    },
    "views": {
      "vmm": [
        {
          "id": "vmm.clusters",
          "name": "Clusters",
          "icon": "$(vm)",
          "contextualTitle": "Virtual Machines"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vmm.clusters",
        "contents": "No hypervisor provider is installed yet. Providers are separate extensions so each hypervisor can be updated independently.\n[$(extensions) Install a Provider](command:vmm.installProviders)\n[Get Started](command:vmm.showWalkthrough)",
        "when": "!vmm.hasProviders"
      },
      {
        "view": "vmm.clusters",
        "contents": "No clusters configured. A cluster groups the nodes (hosts) of one hypervisor, for example your local Hyper-V or a Proxmox cluster.\n[$(add) Add Cluster](command:vmm.addCluster)\n[Get Started](command:vmm.showWalkthrough)",
        "when": "vmm.hasProviders && !vmm.hasClusters"
      }
    ],
    "commands": [
      {
        "command": "vmm.addCluster",
        "title": "Add Cluster",
        "category": "VM",
        "icon": "$(add)"
      },
      {
        "command": "vmm.editCluster",
        "title": "Edit Cluster",
        "category": "VM",
        "icon": "$(edit)"
      },
      {
        "command": "vmm.removeCluster",
        "title": "Remove Cluster",
        "category": "VM",
        "icon": "$(trash)"
      },
      {
        "command": "vmm.reconnectCluster",
        "title": "Reconnect",
        "category": "VM",
        "icon": "$(plug)"
      },
      {
        "command": "vmm.cancelConnect",
        "title": "Cancel Sign-in",
        "category": "VM",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vmm.signOut",
        "title": "Sign Out",
        "category": "VM",
        "icon": "$(sign-out)"
      },
      {
        "command": "vmm.searchVms",
        "title": "Search Virtual Machines…",
        "category": "VM",
        "icon": "$(search)"
      },
      {
        "command": "vmm.refresh",
        "title": "Refresh",
        "category": "VM",
        "icon": "$(refresh)"
      },
      {
        "command": "vmm.openOverview",
        "title": "Open Overview",
        "category": "VM",
        "icon": "$(dashboard)"
      },
      {
        "command": "vmm.installProviders",
        "title": "Install Hypervisor Providers",
        "category": "VM",
        "icon": "$(extensions)"
      },
      {
        "command": "vmm.showWalkthrough",
        "title": "Get Started with VM Manager",
        "category": "VM",
        "icon": "$(book)"
      },
      {
        "command": "vmm.createVm",
        "title": "Create Virtual Machine",
        "category": "VM",
        "icon": "$(add)"
      },
      {
        "command": "vmm.attachRunningVm",
        "title": "Attach to Running Virtual Machine…",
        "category": "VM",
        "icon": "$(plug)"
      },
      {
        "command": "vmm.importFromFolder",
