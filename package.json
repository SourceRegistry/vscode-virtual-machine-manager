        {
          "command": "vmm.detachVm",
          "when": "view == vmm.clusters && viewItem =~ /^vm;.*\\bdetach;/",
          "group": "3_manage@3"
        },
        {
          "command": "vmm.copyId",
          "when": "view == vmm.clusters && viewItem =~ /^vm;/",
          "group": "9_copy@1"
        }
      ],
      "editor/title": [
        {
          "command": "vmm.console.sendCtrlAltDel",
          "when": "activeWebviewPanelId =~ /^vmm\\.console\\.(vnc|rdp)$/",
          "group": "navigation@1"
        },
        {
          "command": "vmm.console.toggleScaling",
          "when": "activeWebviewPanelId =~ /^vmm\\.console\\.(vnc|rdp|preview)$/",
          "group": "navigation@2"
        },
        {
          "command": "vmm.console.typeClipboard",
          "when": "activeWebviewPanelId =~ /^vmm\\.console\\.(vnc|rdp|serial)$/",
          "group": "navigation@3"
        },
        {
          "command": "vmm.console.openInNewWindow",
          "when": "activeWebviewPanelId =~ /^vmm\\.console\\./",
          "group": "navigation@4"
        },
        {
          "command": "vmm.console.reconnect",
          "when": "activeWebviewPanelId =~ /^vmm\\.console\\./",
          "group": "1_console@1"
        },
        {
          "command": "vmm.console.shutdown",
          "when": "activeWebviewPanelId =~ /^vmm\\.console\\./",
          "group": "2_power@1"
        },
        {
          "command": "vmm.console.reboot",
          "when": "activeWebviewPanelId =~ /^vmm\\.console\\./",
          "group": "2_power@2"
        },
        {
          "command": "vmm.console.stop",
          "when": "activeWebviewPanelId =~ /^vmm\\.console\\./",
          "group": "2_power@3"
        }
      ],
      "webview/context": [
        {
          "command": "vmm.cancelConnect",
          "when": "webviewId == vmm.overview && vmmItem =~ /^cluster;status=connecting;/",
          "group": "1_connection@3"
        },
        {
          "command": "vmm.reconnectCluster",
          "when": "webviewId == vmm.overview && vmmItem =~ /^cluster;/",
          "group": "1_connection@1"
        },
        {
          "command": "vmm.signOut",
          "when": "webviewId == vmm.overview && vmmItem =~ /^cluster;.*\\bsignout;/",
          "group": "1_connection@2"
        },
        {
          "command": "vmm.editCluster",
          "when": "webviewId == vmm.overview && vmmItem =~ /^cluster;/",
          "group": "2_manage@1"
        },
        {
          "command": "vmm.removeCluster",
          "when": "webviewId == vmm.overview && vmmItem =~ /^cluster;/",
          "group": "2_manage@2"
        },
        {
          "command": "vmm.forgetConsoleCredentials",
          "when": "webviewId == vmm.overview && vmmItem =~ /^cluster;.*\\brdp;/",
          "group": "2_manage@3"
        },
        {
          "command": "vmm.createVm",
          "when": "webviewId == vmm.overview && vmmItem =~ /^node;.*\\bcreate;/",
          "group": "1_create@1"
        },
        {
          "command": "vmm.attachRunningVm",
          "when": "webviewId == vmm.overview && vmmItem =~ /^node;.*\\badopt;/",
          "group": "1_create@2"
        },
        {
          "command": "vmm.importFromFolder",
          "when": "webviewId == vmm.overview && vmmItem =~ /^node;.*\\bimport;/",
          "group": "1_create@3"
        },
        {
          "command": "vmm.refresh",
          "when": "webviewId == vmm.overview && vmmItem =~ /^node;/",
          "group": "9_refresh@1"
        },
        {
          "command": "vmm.start",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;state=(stopped|saved|paused);.*\\bstart;/",
          "group": "1_power@1"
        },
        {
          "command": "vmm.shutdown",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;state=running;.*\\bshutdown;/",
          "group": "1_power@2"
        },
        {
          "command": "vmm.reboot",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;state=running;.*\\breboot;/",
          "group": "1_power@3"
        },
        {
          "command": "vmm.stop",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;state=(running|paused|starting|stopping|unknown);.*\\bstop;/",
          "group": "1_power@4"
        },
        {
          "command": "vmm.connectGraphical",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bgraphical;/",
          "group": "2_connect@1"
        },
        {
          "command": "vmm.connectSerial",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bserial;/",
          "group": "2_connect@2"
        },
        {
          "command": "vmm.openExternal",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bexternal;/",
          "group": "2_connect@3"
        },
        {
          "command": "vmm.connectSsh",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;state=running;.*\\bdetails;/",
          "group": "2_connect@4"
        },
        {
          "command": "vmm.ejectMedia",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bejectable;/",
          "group": "2_media@1"
        },
        {
          "command": "vmm.changeMedia",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bmedia;/",
          "group": "2_media@2"
        },
        {
          "command": "vmm.takeSnapshot",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bsnapshots;/",
          "group": "2_snapshots@1"
        },
        {
          "command": "vmm.revertSnapshot",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bsnapshots;/",
          "group": "2_snapshots@2"
        },
        {
          "command": "vmm.deleteSnapshot",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bsnapshots;/",
          "group": "2_snapshots@3"
        },
        {
          "command": "vmm.openVmDashboard",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bdetails;/",
          "group": "3_manage@0"
        },
        {
          "command": "vmm.editVm",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bedit;/",
          "group": "3_manage@1"
        },
        {
          "command": "vmm.cloneVm",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bclone;/",
          "group": "3_manage@2"
        },
        {
          "command": "vmm.createFromTemplate",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bistemplate;/",
          "group": "3_manage@2"
        },
        {
          "command": "vmm.convertToTemplate",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\btotemplate;/",
          "group": "3_manage@2"
        },
        {
          "command": "vmm.convertToVm",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bistemplate;/",
          "group": "3_manage@2"
        },
        {
          "command": "vmm.deleteVm",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bdelete;/",
          "group": "3_manage@3"
        },
        {
          "command": "vmm.detachVm",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;.*\\bdetach;/",
          "group": "3_manage@3"
        },
        {
          "command": "vmm.copyId",
          "when": "webviewId == vmm.overview && vmmItem =~ /^vm;/",
          "group": "9_copy@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "VM Manager",
        "properties": {
          "vmm.refreshInterval": {
            "type": "number",
            "default": 5,
            "minimum": 1,
            "maximum": 300,
            "markdownDescription": "Seconds between state refreshes while the Clusters view or the Overview is visible. Providers that push change events refresh immediately."
          },
          "vmm.console.openInNewWindow": {
            "type": "boolean",
            "default": false,
            "description": "Open consoles directly in a new window instead of an editor tab."
          },
          "vmm.console.scaleViewport": {
            "type": "boolean",
            "default": true,
            "description": "Scale graphical consoles to fit the editor."
          },
          "vmm.confirmPowerOff": {
            "type": "boolean",
            "default": true,
            "description": "Ask for confirmation before a hard power off (Stop)."
          },
          "vmm.ssh.user": {
            "type": "string",
            "default": "",
            "markdownDescription": "The account to sign in as inside a guest when connecting with **VM: Connect with Remote-SSH…**. Empty: your user name on this computer. The answer is remembered per machine."
          },
          "vmm.ssh.addConfigEntry": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Offer to add an entry for the machine to your ssh config before connecting (it is always shown first and never written silently). Turn off to connect by address without touching the file."
          }
        }
      },
      {
        "title": "QEMU",
        "properties": {
          "vmm.qemu.path": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "markdownDescription": "Directory containing `qemu-system-*` and `qemu-img`. Leave empty to detect from `PATH` and common install locations. Clusters can override this."
          }
        }
      },
      {
        "title": "Proxmox VE",
        "properties": {
          "vmm.proxmox.rememberSession": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Keep the Proxmox sign-in (OpenID Connect or password) in the operating system keychain after VS Code closes or reloads, so the next start reuses it while it is valid (Proxmox sessions last 2 hours) instead of asking again. Off: the session is forgotten when VS Code closes. **Sign Out** always removes it."
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get Started with VM Manager",
        "description": "Manage Hyper-V, QEMU and other hypervisors without leaving VS Code.",
        "steps": [
          {
            "id": "installProvider",
            "title": "Install a hypervisor provider",
            "description": "Each hypervisor is supported by its own small extension, so it can be updated independently.\n[Install Providers](command:vmm.installProviders)",
            "media": {
              "markdown": "media/walkthrough/providers.md"
            },
            "completionEvents": [
              "onContext:vmm.hasProviders"
            ]
          },
          {
            "id": "addCluster",
            "title": "Add your first cluster",
            "description": "A cluster is one hypervisor installation, for example ``Local (Hyper-V)``. It contains nodes (hosts) which run your virtual machines.\n[Add Cluster](command:vmm.addCluster)",
            "media": {
              "svg": "media/walkthrough/hierarchy.svg",
              "altText": "Cluster, node and virtual machine hierarchy"
            },
            "completionEvents": [
              "onContext:vmm.hasClusters"
            ]
          },
          {
            "id": "createVm",
            "title": "Create or pick a virtual machine",
            "description": "Right-click a node to create a virtual machine, or use the actions next to an existing one to start, shut down, reboot or stop it.\n[Create Virtual Machine](command:vmm.createVm)",
            "media": {
              "markdown": "media/walkthrough/power.md"
            },
            "completionEvents": [
              "onContext:vmm.hasVms"
            ]
          },
          {
            "id": "connect",
            "title": "Connect to a console",
            "description": "Graphical consoles use noVNC and serial consoles use xterm, right inside an editor tab. Use **Open in New Window** in the editor toolbar to pop a console out.\n[Connect Graphical Console](command:vmm.connectGraphical)",
            "media": {
              "markdown": "media/walkthrough/consoles.md"
            },
            "completionEvents": [
              "onCommand:vmm.connectGraphical",
              "onCommand:vmm.connectSerial"
            ]
          },
          {
            "id": "overview",
            "title": "See everything at a glance",
            "description": "The overview shows every cluster, node and virtual machine with its state and resources.\n[Open Overview](command:vmm.openOverview)",
            "media": {
              "markdown": "media/walkthrough/overview.md"
            },
            "completionEvents": [
              "onCommand:vmm.openOverview"
            ]
          },
          {
            "id": "credentials",
            "title": "Your credentials stay safe",
            "description": "Passwords and API tokens are stored in the operating system keychain through VS Code Secret Storage. They are never written to settings files and never sent to the webviews.",
            "media": {
              "markdown": "media/walkthrough/credentials.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          }
        ]
      }
    ]
  },
