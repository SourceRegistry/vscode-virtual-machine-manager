        "category": "VM",
        "icon": "$(add)"
      },
      {
        "command": "vmm.removeSshConfigEntries",
        "title": "Remove Machines from SSH Config…",
        "category": "VM",
        "icon": "$(remove)"
      },
      {
        "command": "vmm.cloneVm",
        "title": "Clone…",
        "category": "VM",
        "icon": "$(copy)"
      },
      {
        "command": "vmm.convertToTemplate",
        "title": "Convert to Template…",
        "category": "VM",
        "icon": "$(library)"
      },
      {
        "command": "vmm.convertToVm",
        "title": "Convert to Virtual Machine",
        "category": "VM",
        "icon": "$(vm)"
      },
      {
        "command": "vmm.createFromTemplate",
        "title": "New Machine from Template…",
        "category": "VM",
        "icon": "$(add)"
      },
      {
        "command": "vmm.takeSnapshot",
        "title": "Take Snapshot…",
        "category": "VM",
        "icon": "$(device-camera)"
      },
      {
        "command": "vmm.revertSnapshot",
        "title": "Revert to Snapshot…",
        "category": "VM",
        "icon": "$(history)"
      },
      {
        "command": "vmm.deleteSnapshot",
        "title": "Delete Snapshot…",
        "category": "VM",
        "icon": "$(trash)"
      },
      {
        "command": "vmm.deleteVm",
        "title": "Delete",
        "category": "VM",
        "icon": "$(trash)"
      },
      {
        "command": "vmm.detachVm",
        "title": "Detach",
        "category": "VM",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "vmm.start",
        "title": "Start",
        "category": "VM",
        "icon": "$(play)"
      },
      {
        "command": "vmm.shutdown",
        "title": "Shut Down",
        "category": "VM",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vmm.reboot",
        "title": "Reboot",
        "category": "VM",
        "icon": "$(debug-restart)"
      },
      {
        "command": "vmm.stop",
        "title": "Stop (Power Off)",
        "category": "VM",
        "icon": "$(stop-circle)"
      },
      {
        "command": "vmm.connectGraphical",
        "title": "Connect Graphical Console",
        "category": "VM",
        "icon": "$(device-desktop)"
      },
      {
        "command": "vmm.connectSerial",
        "title": "Connect Serial Console",
        "category": "VM",
        "icon": "$(terminal)"
      },
      {
        "command": "vmm.openExternal",
        "title": "Open in Native Viewer",
        "category": "VM",
        "icon": "$(link-external)"
