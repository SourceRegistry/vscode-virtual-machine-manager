        {
          "command": "vmm.cloneVm",
          "when": "vmm.hasVms"
        },
        {
          "command": "vmm.convertToTemplate",
          "when": "vmm.hasVms"
        },
        {
          "command": "vmm.convertToVm",
          "when": "vmm.hasVms"
        },
        {
